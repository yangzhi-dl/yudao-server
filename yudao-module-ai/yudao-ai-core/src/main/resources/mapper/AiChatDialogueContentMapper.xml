<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.iocoder.yudao.module.ai.core.chat.dal.mysql.AiChatDialogueContentMapper">

    <insert id="batchInsert">
        insert into ai_chat_dialogue_content (dialogue_id, content)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.dialogueId}, #{item.content})
        </foreach>
    </insert>

</mapper>
