<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.iocoder.yudao.module.ai.core.chat.dal.mysql.AiChatSettingsMapper">

    <resultMap id="SettingResultMap" type="cn.iocoder.yudao.module.ai.core.chat.dal.dataobject.ModelSettingDO">
        <id column="user_id" property="userId"/>
        <result column="configs" property="configs"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"
                javaType="java.util.List"/>
        <result column="creator" property="creator"/>
        <result column="create_time" property="createTime"/>
        <result column="updater" property="updater"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!-- 查询使用指定模型的所有用户 ID（在 JSON 数组中匹配 id） -->
    <select id="selectUserIdByModelId" resultType="java.lang.Long">
        SELECT user_id
        FROM ai_chat_settings
        WHERE deleted = 0
          AND JSON_CONTAINS(configs, JSON_OBJECT('id', #{modelId}))
    </select>

    <!-- 按用户更新模型设置（configs 完整覆盖） -->
    <update id="updateModelSettingByUser">
        UPDATE ai_chat_settings
        SET configs  = #{configs, typeHandler=com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler},
            updater  = #{creator},
            update_time = NOW()
        WHERE creator = #{creator}
          AND deleted = 0
    </update>

</mapper>
